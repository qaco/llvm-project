; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[X_LCSSA:%.*]] = phi <2 x double> [ [[X]], %[[LOOP]] ]
; CHECK-NEXT:    [[ADD_LCSSA:%.*]] = phi <4 x double> [ [[ADD]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.masked.store.v4f64.p0(<4 x double> [[ADD_LCSSA]], ptr align 32 [[TILE]], <4 x i1> <i1 true, i1 true, i1 true, i1 false>)
