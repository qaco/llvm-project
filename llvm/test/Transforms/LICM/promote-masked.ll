; Negative: an unknown call in the loop may read or write the location.

define void @opaque_call_in_loop(ptr noalias %acc, i64 %n) {
; CHECK-LABEL: define void @opaque_call_in_loop(
; CHECK-SAME: ptr noalias [[ACC:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[V:%.*]] = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 [[ACC]], <4 x i1> splat (i1 true), <4 x double> poison)
; CHECK-NEXT:    [[ADD:%.*]] = fadd <4 x double> [[V]], splat (double 1.000000e+00)
; CHECK-NEXT:    call void @llvm.masked.store.v4f64.p0(<4 x double> [[ADD]], ptr align 32 [[ACC]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    call void @use(ptr [[ACC]])
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
