; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ACC_PROMOTED:%.*]] = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 [[ACC]], <4 x i1> splat (i1 true), <4 x double> poison)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[ADD1:%.*]] = phi <4 x double> [ [[ACC_PROMOTED]], %[[ENTRY]] ], [ [[ADD:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr double, ptr [[SRC]], i64 [[I]]
; CHECK-NEXT:    [[X:%.*]] = load <4 x double>, ptr [[GEP]], align 32
; CHECK-NEXT:    [[ADD]] = fadd <4 x double> [[ADD1]], [[X]]
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[ADD_LCSSA:%.*]] = phi <4 x double> [ [[ADD]], %[[LOOP]] ]
; CHECK-NEXT:    call void @llvm.masked.store.v4f64.p0(<4 x double> [[ADD_LCSSA]], ptr align 32 [[ACC]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %v = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 %acc, <4 x i1> splat (i1 true), <4 x double> poison)
  %gep = getelementptr double, ptr %src, i64 %i
  %x = load <4 x double>, ptr %gep, align 32
  %add = fadd <4 x double> %v, %x
  call void @llvm.masked.store.v4f64.p0(<4 x double> %add, ptr align 32 %acc, <4 x i1> splat (i1 true))
  %i.next = add i64 %i, 4
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

