; Negative: a varying mask means the set of live lanes changes per iteration,
; so no single load/store pair can stand in for the loop's accesses.

define void @variant_mask(ptr noalias %acc, ptr noalias %src, i64 %n) {
; CHECK-LABEL: define void @variant_mask(
; CHECK-SAME: ptr noalias [[ACC:%.*]], ptr noalias [[SRC:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[IV:%.*]] = insertelement <4 x i64> poison, i64 [[I]], i32 0
; CHECK-NEXT:    [[SP:%.*]] = shufflevector <4 x i64> [[IV]], <4 x i64> poison, <4 x i32> zeroinitializer
; CHECK-NEXT:    [[MASK:%.*]] = icmp ult <4 x i64> [[SP]], splat (i64 3)
; CHECK-NEXT:    [[V:%.*]] = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 [[ACC]], <4 x i1> [[MASK]], <4 x double> poison)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr double, ptr [[SRC]], i64 [[I]]
; CHECK-NEXT:    [[X:%.*]] = load <4 x double>, ptr [[GEP]], align 32
; CHECK-NEXT:    [[ADD:%.*]] = fadd <4 x double> [[V]], [[X]]
; CHECK-NEXT:    call void @llvm.masked.store.v4f64.p0(<4 x double> [[ADD]], ptr align 32 [[ACC]], <4 x i1> [[MASK]])
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %iv = insertelement <4 x i64> poison, i64 %i, i32 0
  %sp = shufflevector <4 x i64> %iv, <4 x i64> poison, <4 x i32> zeroinitializer
  %mask = icmp ult <4 x i64> %sp, splat (i64 3)
  %v = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 %acc, <4 x i1> %mask, <4 x double> poison)
  %gep = getelementptr double, ptr %src, i64 %i
  %x = load <4 x double>, ptr %gep, align 32
  %add = fadd <4 x double> %v, %x
  call void @llvm.masked.store.v4f64.p0(<4 x double> %add, ptr align 32 %acc, <4 x i1> %mask)
  %i.next = add i64 %i, 4
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; Negative: another access in the loop may touch the same location, so a value
; carried in a register would go stale.

define void @aliasing_access_in_loop(ptr %acc, ptr %other, i64 %n) {
