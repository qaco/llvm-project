; CHECK-NEXT:    [[ROW1:%.*]] = getelementptr inbounds double, ptr [[TILE]], i64 3
; CHECK-NEXT:    [[TILE_PROMOTED:%.*]] = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 [[TILE]], <4 x i1> <i1 true, i1 true, i1 true, i1 false>, <4 x double> poison)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[ADD1:%.*]] = phi <4 x double> [ [[TILE_PROMOTED]], %[[ENTRY]] ], [ [[ADD:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr double, ptr [[SRC]], i64 [[I]]
; CHECK-NEXT:    [[X:%.*]] = load <2 x double>, ptr [[GEP]], align 16
; CHECK-NEXT:    [[XW:%.*]] = shufflevector <2 x double> [[X]], <2 x double> poison, <4 x i32> <i32 0, i32 1, i32 0, i32 1>
