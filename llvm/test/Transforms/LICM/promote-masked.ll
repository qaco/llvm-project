; The store is conditional, so it does not dominate the exit and cannot be
; sunk. The load still executes on every iteration, so it is hoisted on its
; own and the store stays in the loop -- LICM's load-only promotion.

define void @store_does_not_dominate_exit(ptr noalias %acc, ptr noalias %src, i64 %n, i1 %c) {
; CHECK-LABEL: define void @store_does_not_dominate_exit(
; CHECK-SAME: ptr noalias [[ACC:%.*]], ptr noalias [[SRC:%.*]], i64 [[N:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ACC_PROMOTED:%.*]] = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 [[ACC]], <4 x i1> splat (i1 true), <4 x double> poison)
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[ADD2:%.*]] = phi <4 x double> [ [[ACC_PROMOTED]], %[[ENTRY]] ], [ [[ADD1:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH]] ]
; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[LATCH]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr double, ptr [[SRC]], i64 [[I]]
; CHECK-NEXT:    [[X:%.*]] = load <4 x double>, ptr [[GEP]], align 32
; CHECK-NEXT:    [[ADD:%.*]] = fadd <4 x double> [[ADD2]], [[X]]
; CHECK-NEXT:    call void @llvm.masked.store.v4f64.p0(<4 x double> [[ADD]], ptr align 32 [[ACC]], <4 x i1> splat (i1 true))
; CHECK-NEXT:    br label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[ADD1]] = phi <4 x double> [ [[ADD]], %[[THEN]] ], [ [[ADD2]], %[[LOOP]] ]
; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[I_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %latch ]
  %v = call <4 x double> @llvm.masked.load.v4f64.p0(ptr align 32 %acc, <4 x i1> splat (i1 true), <4 x double> poison)
  br i1 %c, label %then, label %latch

then:
  %gep = getelementptr double, ptr %src, i64 %i
  %x = load <4 x double>, ptr %gep, align 32
  %add = fadd <4 x double> %v, %x
  call void @llvm.masked.store.v4f64.p0(<4 x double> %add, ptr align 32 %acc, <4 x i1> splat (i1 true))
  br label %latch

latch:
  %i.next = add i64 %i, 4
  %cmp = icmp ult i64 %i.next, %n
  br i1 %cmp, label %loop, label %exit

exit:
  ret void
}

; A scalable access has no statically known extent, but alias analysis models
; that directly, so promotion needs nothing special for it.

define void @scalable_access(ptr noalias %acc, ptr noalias %src, i64 %n) {
